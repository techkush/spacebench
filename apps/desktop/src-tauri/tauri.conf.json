{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Space Bench",
  "version": "0.1.0",
  "identifier": "app.spicebench.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Space Bench",
        "width": 1600,
        "height": 1000,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true,
        "maximized": true,
        "titleBarStyle": "Overlay",
        "trafficLightPosition": { "x": 18, "y": 26 },
        "hiddenTitle": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}